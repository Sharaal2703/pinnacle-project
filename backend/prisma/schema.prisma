datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum PathwayCode {
  LING
  LOGI
  VIS
  MUSI
  BODY
  NAT
  INTER
  INTRA
}

enum VarkType {
  V
  A
  R
  K
}

enum QuestionType {
  SELF_REPORT
  SCENARIO
}

enum ReviewStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  SCORED
  INCOMPLETE
  EXPIRED
}

enum ObserverRole {
  PARENT
  TEACHER
}

enum LearningResourceFormat {
  VIDEO
  IMAGE
  PDF
}

enum LearningResourceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  NEEDS_REVISION
  ARCHIVED
}

enum ConceptProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  email        String?
  phone        String?
  location     String?

  student                Student?
  teacher                Teacher?
  observations           Observation[]
  assessmentRetakeGrants AssessmentRetakeGrant[] @relation("AssessmentRetakeGrantIssuer")
  createdLearningResources LearningResource[] @relation("LearningResourceCreator")
  reviewedLearningResources LearningResource[] @relation("LearningResourceReviewer")
  uploadedLearningResources LearningResource[] @relation("LearningResourceUploader")

  @@map("users")
}

model Student {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade           Int
  schoolId        String?
  school          School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  classId         String?
  schoolClass     SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  admissionNumber String?
  createdAt       DateTime     @default(now())

  attempts               AssessmentAttempt[]
  profiles               PreferenceProfile[]
  guardians              StudentGuardian[]
  observations           Observation[]
  assessmentRetakeGrants AssessmentRetakeGrant[]
  conceptProgress        ConceptProgress[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, classId])
  @@map("students")
}

model Pathway {
  id   String      @id @default(uuid())
  code PathwayCode @unique
  name String

  optionMappings     QuestionOptionMapping[]
  dominantProfiles   PreferenceProfile[]               @relation("DominantPathway")
  secondaryProfiles  PreferenceProfile[]               @relation("SecondaryPathway")
  scores             PreferenceScore[]
  questionMappings   QuestionIntelligenceTypeMapping[]
  observationRatings ObservationRating[]

  @@map("intelligence_types")

  learningResources LearningResource[]
}

model School {
  id         String   @id @default(uuid())
  schoolName String
  address    String?
  city       String?
  district   String?
  state      String?
  pincode    String?
  createdAt  DateTime @default(now())

  students Student[]
  classes  SchoolClass[]
  teachers Teacher[]

  @@map("schools")
}

model SchoolClass {
  id           String @id @default(uuid())
  schoolId     String
  school       School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade        Int    @db.SmallInt
  section      String @db.VarChar(10)
  academicYear String @db.VarChar(9)

  students    Student[]
  assignments TeacherClassAssignment[]

  @@unique([schoolId, grade, section, academicYear])
  @@map("classes")
}

model Teacher {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId       String
  school         School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  employeeNumber String?

  assignments TeacherClassAssignment[]

  @@unique([schoolId, employeeNumber])
  @@map("teachers")
}

model Subject {
  id          String                   @id @default(uuid())
  code        String                   @unique
  name        String                   @unique
  assignments TeacherClassAssignment[]
  chapters    CurriculumChapter[]

  @@map("subjects")
}

model CurriculumChapter {
  id                  String   @id @default(uuid())
  subjectId           String
  subject             Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  grade               Int      @db.SmallInt
  title               String   @db.VarChar(200)
  term                Int?     @db.SmallInt
  description         String?
  curriculumReference String?
  orderIndex          Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  concepts CurriculumConcept[]

  @@unique([subjectId, grade, term, orderIndex])
  @@index([grade, subjectId, isActive])
  @@map("curriculum_chapters")
}

model CurriculumConcept {
  id                  String            @id @default(uuid())
  chapterId           String
  chapter             CurriculumChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  conceptKey          String            @db.VarChar(100)
  title               String            @db.VarChar(200)
  description         String?
  learningObjective   String?
  curriculumReference String?
  orderIndex          Int               @default(0)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  resources LearningResource[]
  progress  ConceptProgress[]

  @@unique([chapterId, conceptKey])
  @@unique([chapterId, orderIndex])
  @@index([chapterId, isActive])
  @@map("curriculum_concepts")
}

model LearningResource {
  id              String                @id @default(uuid())
  resourceKey     String                @db.VarChar(100)
  version         Int                   @default(1)
  conceptId       String
  concept         CurriculumConcept     @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  pathwayId       String
  pathway         Pathway               @relation(fields: [pathwayId], references: [id], onDelete: Restrict)
  format          LearningResourceFormat
  languageCode    String                @default("en") @db.VarChar(10)
  title           String                @db.VarChar(200)
  status          LearningResourceStatus @default(DRAFT)
  storageBucket   String?               @db.VarChar(100)
  storagePath     String?               @db.VarChar(500)
  mimeType        String?               @db.VarChar(100)
  fileSizeBytes   BigInt?
  durationSeconds Int?
  sourceReference String?
  createdById     String
  createdBy       User                  @relation("LearningResourceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById    String?
  reviewedBy      User?                 @relation("LearningResourceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  uploadedById    String?
  uploadedBy      User?                 @relation("LearningResourceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewNotes     String?
  reviewedAt      DateTime?
  publishedAt     DateTime?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  progress ConceptProgress[]

  @@unique([resourceKey, version])
  @@unique([storageBucket, storagePath])
  @@index([conceptId, status, isActive])
  @@index([pathwayId, status, languageCode])
  @@map("learning_resources")
}

model ConceptProgress {
  id                String               @id @default(uuid())
  studentId         String
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conceptId         String
  concept           CurriculumConcept    @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  status            ConceptProgressStatus @default(NOT_STARTED)
  progressPercent   Int                  @default(0) @db.SmallInt
  lastResourceId    String?
  lastResource      LearningResource?    @relation(fields: [lastResourceId], references: [id], onDelete: SetNull)
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime             @updatedAt

  @@unique([studentId, conceptId])
  @@index([studentId, status])
  @@map("concept_progress")
}

model TeacherClassAssignment {
  id          String      @id @default(uuid())
  teacherId   String
  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([teacherId, classId, subjectId])
  @@map("teacher_class_assignments")
}

model StudentGuardian {
  id            String  @id @default(uuid())
  studentId     String
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianName  String
  guardianPhone String
  guardianEmail String?
  relationship  String
  isPrimary     Boolean @default(false)

  @@map("student_guardian")
}

model AssessmentRetakeGrant {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grantedById String
  grantedBy   User      @relation("AssessmentRetakeGrantIssuer", fields: [grantedById], references: [id], onDelete: Restrict)
  grantedAt   DateTime  @default(now())
  consumedAt  DateTime?
  revokedAt   DateTime?

  @@index([studentId, consumedAt, revokedAt])
  @@map("assessment_retake_grants")
}

model QuestionnaireVersion {
  id                  String       @id @default(uuid())
  questionnaireId     String
  version             String
  languageCode        String
  gradeMin            Int          @default(6)
  gradeMax            Int          @default(8)
  sessionTimeLimitSec Int          @default(2280)
  reviewStatus        ReviewStatus @default(DRAFT)
  reviewerName        String?
  reviewNotes         String?
  reviewedAt          DateTime?
  isActive            Boolean      @default(false)
  createdAt           DateTime     @default(now())

  questions QuestionVersion[]
  attempts  AssessmentAttempt[]

  @@unique([questionnaireId, languageCode, version])
  @@map("questionnaire_versions")
}

model QuestionSource {
  id           String  @id
  title        String
  url          String?
  citationNote String?

  questions QuestionVersion[]

  @@map("question_sources")
}

model QuestionVersion {
  id                     String                @id @default(uuid())
  key                    String
  version                Int                   @default(1)
  type                   QuestionType
  prompt                 String
  gradeMin               Int                   @default(6)
  gradeMax               Int                   @default(8)
  weight                 Decimal               @default(1.0)
  timeLimitSec           Int                   @default(45)
  reviewStatus           ReviewStatus          @default(DRAFT)
  reviewerName           String?
  reviewNotes            String?
  reviewedAt             DateTime?
  isActive               Boolean               @default(false)
  mediaUrl               String?
  questionnaireVersionId String?
  questionnaireVersion   QuestionnaireVersion? @relation(fields: [questionnaireVersionId], references: [id], onDelete: SetNull)
  sourceId               String?
  source                 QuestionSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  selectionOrder         Int?
  createdAt              DateTime              @default(now())

  options              QuestionOption[]
  responses            AssessmentResponse[]
  intelligenceMappings QuestionIntelligenceTypeMapping[]

  @@unique([key, version])
  @@index([questionnaireVersionId])
  @@index([sourceId])
  @@map("questions")
}

model QuestionIntelligenceTypeMapping {
  id                String          @id @default(uuid())
  questionVersionId String
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  pathwayId         String
  pathway           Pathway         @relation(fields: [pathwayId], references: [id], onDelete: Restrict)
  contribution      Decimal         @default(1.0)

  @@unique([questionVersionId, pathwayId])
  @@map("question_intelligence_type_mappings")
}

model QuestionOption {
  id                String          @id @default(uuid())
  questionVersionId String
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  optionKey         String
  label             String
  orderIndex        Int             @default(0)
  varkType          VarkType?

  pathwayMappings QuestionOptionMapping[]
  responses       AssessmentResponse[]

  @@unique([questionVersionId, optionKey])
  @@map("question_options")
}

model QuestionOptionMapping {
  id           String         @id @default(uuid())
  optionId     String
  option       QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  pathwayId    String
  pathway      Pathway        @relation(fields: [pathwayId], references: [id])
  contribution Decimal        @default(1.0)

  @@unique([optionId, pathwayId])
  @@map("option_intelligence_type_mapping")
}

model AssessmentAttempt {
  id                     String                @id @default(uuid())
  studentId              String
  student                Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNo              Int                   @default(1)
  status                 AttemptStatus         @default(IN_PROGRESS)
  questionOrder          Json // array of QuestionVersion IDs in fixed order
  currentIndex           Int                   @default(1) // 1 to 40
  startedAt              DateTime              @default(now())
  submittedAt            DateTime?
  scoringConfigVersion   String                @default("1.0.0")
  totalTimeLimitSec      Int                   @default(2280)
  expiresAt              DateTime?
  questionnaireVersionId String?
  questionnaireVersion   QuestionnaireVersion? @relation(fields: [questionnaireVersionId], references: [id], onDelete: SetNull)

  responses AssessmentResponse[]
  profile   PreferenceProfile?

  @@unique([studentId, attemptNo])
  @@index([questionnaireVersionId])
  @@map("assessment_sessions")
}

model AssessmentResponse {
  id                String            @id @default(uuid())
  attemptId         String
  attempt           AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionVersionId String
  questionVersion   QuestionVersion   @relation(fields: [questionVersionId], references: [id])
  optionId          String?
  option            QuestionOption?   @relation(fields: [optionId], references: [id])
  answerJson        Json // { rating: number } or { option_id: string }
  shownAt           DateTime
  answeredAt        DateTime?
  timeTakenMs       Int?
  timedOut          Boolean           @default(false)
  responseWeight    Decimal           @default(0.0)

  @@unique([attemptId, questionVersionId])
  @@map("responses")
}

model PreferenceProfile {
  id                 String            @id @default(uuid())
  studentId          String
  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptId          String            @unique
  attempt            AssessmentAttempt @relation(fields: [attemptId], references: [id])
  isCurrent          Boolean           @default(true)
  dominantPathwayId  String
  dominantPathway    Pathway           @relation("DominantPathway", fields: [dominantPathwayId], references: [id])
  secondaryPathwayId String
  secondaryPathway   Pathway           @relation("SecondaryPathway", fields: [secondaryPathwayId], references: [id])
  tie                Boolean           @default(false)
  scoringVersion     String            @default("1.0.0")
  createdAt          DateTime          @default(now())

  scores PreferenceScore[]

  @@map("intelligence_profile")
}

model PreferenceScore {
  id              String            @id @default(uuid())
  profileId       String
  profile         PreferenceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pathwayId       String
  pathway         Pathway           @relation(fields: [pathwayId], references: [id])
  rawScore        Decimal           @default(0.0)
  maxScore        Decimal           @default(0.0)
  normalizedScore Decimal?
  rankNo          Int

  @@unique([profileId, pathwayId])
  @@map("intelligence_scores")
}

model Observation {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  observerUserId String
  observer       User         @relation(fields: [observerUserId], references: [id], onDelete: Restrict)
  observerRole   ObserverRole
  remarks        String?
  createdAt      DateTime     @default(now())

  ratings ObservationRating[]

  @@index([studentId, createdAt])
  @@map("observations")
}

model ObservationRating {
  observationId String
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  pathwayId     String
  pathway       Pathway     @relation(fields: [pathwayId], references: [id], onDelete: Restrict)
  rating        Int         @db.SmallInt

  @@id([observationId, pathwayId])
  @@map("observation_ratings")
}

model AssessmentConfig {
  id                    String   @id @default(uuid())
  version               String   @unique
  totalLimitSec         Int      @default(2280)
  selfReportLimitSec    Int      @default(45)
  scenarioLimitSec      Int      @default(75)
  ratingMax             Int      @default(5) @db.SmallInt
  questionCount         Int      @default(40) @db.SmallInt
  selfReportCount       Int      @default(24) @db.SmallInt
  scenarioCount         Int      @default(16) @db.SmallInt
  targetTimeMinSec      Int      @default(1200)
  targetTimeMaxSec      Int      @default(2280)
  gracePeriodSec        Int      @default(2)
  minAnsweredCount      Int      @default(30) @db.SmallInt
  defaultQuestionWeight Decimal  @default(1.0)
  scoringFormulaVersion String   @default("1.0.0")
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  @@map("scoring_config")
}
