# cloud or local database URL. Backend settings take precedence over root Compose settings.

PORT=4000
NODE_ENV=development
JWT_SECRET=local-development-secret-change-before-deployment-123456789
JWT_EXPIRES_IN=2h

DATABASE_URL=postgresql://mindbridge:mindbridge_local_dev_only@localhost:5432/mindbridge?schema=public

# Supabase Storage (Module 2). Keep the service role key in backend/.env only.
# Leave blank until the private Storage bucket is created in Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=mindbridge-learning
