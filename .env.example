# Local development only. Copy to .env and keep it out of version control.
POSTGRES_DB=mindbridge
POSTGRES_USER=mindbridge
POSTGRES_PASSWORD=local-development-only-change-me
POSTGRES_PORT=5432

# Prisma connection for the backend running on the host machine.
DATABASE_URL=postgresql://mindbridge:local-development-only-change-me@localhost:5432/mindbridge?schema=public
